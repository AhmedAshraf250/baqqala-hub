includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # A module's defaults are merged into configuration at boot, so they are
    # captured by config:cache exactly like the files in config/.
    configDirectories:
        - %currentWorkingDirectory%/config
        - %currentWorkingDirectory%/app/Modules/*/Config
